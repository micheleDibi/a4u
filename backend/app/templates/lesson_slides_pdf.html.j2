<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8" />
  <title>{{ course.title }} — {{ lesson.title }} — Slide</title>

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      font-family: "{{ tpl.font_family|css_string }}", "Inter", "Helvetica",
                    "Arial", "Noto Sans CJK JP", "Noto Sans", sans-serif;
      color: {{ tpl.text_color|safe }};
    }

    /* Pagina: full-bleed A4 landscape (297×210 mm). Nessun margine
       dell'@page: la "safe zone" è creata dal padding interno della
       slide, replicando il 6% / 5% della preview. */
    @page {
      size: A4 landscape;
      margin: 0;
    }

    /* Una slide = una pagina, occupa l'intero foglio. */
    .slide {
      position: relative;
      width: 297mm;
      height: 210mm;
      overflow: hidden;
      page-break-after: always;
    }
    .slide:last-child { page-break-after: auto; }

    /* Background: immagine full-bleed con opacità dal template,
       oppure gradient di default. Sotto al contenuto. */
    {% if tpl.background_image_url %}
    .slide-bg {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background-image: url("{{ tpl.background_image_url|css_string }}");
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      opacity: {{ ((tpl.background_opacity_pct or 100) / 100.0) | round(3) | safe }};
      z-index: 0;
    }
    {% else %}
    .slide-bg {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background:
        linear-gradient(135deg,
          #ffffff 0%,
          {{ tpl.primary_color|safe }}0c 55%,
          {{ tpl.secondary_color|safe }}18 100%);
      background-color: #fafafa;
      z-index: 0;
    }
    {% endif %}

    /* Header: logo sinistra + logo destra, top 5% (10mm),
       inset orizzontale 6% (≈18mm). */
    .slide-header {
      position: absolute;
      top: 10mm;
      left: 18mm;
      right: 18mm;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8mm;
      z-index: 5;
    }
    .slide-header .logo-left,
    .slide-header .logo-right {
      max-height: 14mm;
      max-width: 38mm;
      object-fit: contain;
    }
    .slide-header .logo-spacer {
      visibility: hidden;
      width: 1mm;
      height: 1mm;
    }

    /* Body container: inset sx/dx come la preview, top 35mm,
       bottom 55mm. Lo spazio bottom-right (avatar futuro) non viene
       riservato dal body: l'asset è centrato orizzontalmente, quindi
       non intrude la zona avatar; quando l'avatar sarà aggiunto,
       sarà drawn ON TOP del body. Block flow normale, `overflow: hidden`:
       ciò che supera i 120mm sparisce senza errori.

       Geometria misurata (WeasyPrint 69, Helvetica; Chromium fra
       parentesi): body 255 × 120mm (297 − 18 − 24 × 210 − 35 − 55);
       tag 3,2mm (3,7); titolo 10,37mm per riga (line-height esplicito,
       uguale nei due motori); prosa 6,65mm per riga; bullet 5,24mm per
       riga + 2,5mm; didascalia 2,8mm (3,3) + 2mm. Sulla pagina asset-only
       con titolo su una riga restano 92,6mm liberi. Il box della figura
       NON è una costante CSS: `slide_geometry.page_figure_budget` lo
       calcola per ogni pagina resa sul suo contenuto reale (D12) e il
       blocco figura lo emette come `--figure-w`/`--figure-h` sul
       `<figure>`; le regole sotto lo leggono con `var()`. Le costanti
       Python sono il mirror di queste regole: `SlideGeometry`. */
    .slide-body {
      position: absolute;
      left: 18mm;
      right: 24mm;
      top: 35mm;
      bottom: 55mm;
      overflow: hidden;
      z-index: 2;
    }
    .slide-tag {
      font-size: 9pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: {{ tpl.primary_color|safe }};
    }
    .slide-title {
      margin: 3mm 0 0;
      font-size: 28pt;
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.01em;
      color: {{ tpl.text_color|safe }};
    }

    /* Prosa di accompagnamento (subtitle / descrizione discorsiva).
       Renderizzata se `slide.body` non è vuoto. */
    .slide-body-text {
      margin: 5mm 0 0;
      font-size: 13pt;
      line-height: 1.45;
      font-weight: 400;
      opacity: 0.78;
      color: {{ tpl.text_color|safe }};
      max-width: 72ch;
    }

    /* Bullet con dot a gradiente come nella preview. */
    .slide-bullets {
      margin: 5mm 0 0;
      padding: 0;
      list-style: none;
    }
    .slide-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 4mm;
      font-size: 11pt;
      line-height: 1.35;
      margin: 0 0 2.5mm;
      opacity: 0.88;
      color: {{ tpl.text_color|safe }};
    }
    .slide-bullets li::before {
      content: "";
      flex-shrink: 0;
      width: 3mm;
      height: 3mm;
      margin-top: 1.3mm;
      border-radius: 50%;
      background: linear-gradient(135deg,
        {{ tpl.primary_color|safe }},
        {{ tpl.secondary_color|safe }});
    }

    /* Asset: lo spazio verticale della figura è 120mm − tag − titolo
       − prosa − bullet − 4mm di margine − didascalia − 3mm di safety,
       calcolato per pagina resa (`slide_geometry`, D12): nelle pagine
       asset-only con titolo su una riga 86,6mm di immagine, nel video
       (senza split) quello che bullet e prosa lasciano. La larghezza del
       wrapper è `--figure-w` (255mm); senza variabile (tabelle) degrada
       ad `auto`, cioè la stessa larghezza. Equazioni ed esempi non
       ricevono box: nella regola generica `var(--figure-h, 80mm)` ripiega
       sul cap di 80mm di prima (un `aligned` di 8 righe è alto 107mm). */
    .slide-assets {
      margin-top: 4mm;
    }
    .slide-asset {
      max-width: 100%;
      margin: 2mm 0;
      text-align: center;
    }
    .slide-asset figure {
      margin: 0;
      max-width: 100%;
    }
    .slide-asset .figure-body {
      max-width: 100%;
      width: var(--figure-w);
    }
    .slide-asset svg,
    .slide-asset img {
      display: block;
      margin: 0 auto;
      max-width: 100%;
      max-height: var(--figure-h, 80mm);
      width: auto;
      height: auto;
      object-fit: contain;
    }
    .slide-asset table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9pt;
    }
    .slide-asset th, .slide-asset td {
      border: 0.4pt solid #ccc;
      padding: 1mm 2mm;
      text-align: left;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    /* Didascalie delle figure (D4): «Figura.» senza numero nelle slide e
       nei frame video (A2), tondo, etichetta in grassetto. La regola vale
       anche per le didascalie di tabelle ed equazioni. */
    .slide-asset .caption,
    .slide-asset figcaption {
      font-size: 8pt;
      font-style: normal;
      opacity: 0.8;
      margin-top: 2mm;
      text-align: center;
    }
    .slide-asset .figure-label {
      font-weight: 700;
    }
    .slide-asset .placeholder,
    .slide-asset .placeholder-image {
      border: 0.5pt dashed #ccc;
      padding: 4mm;
      font-size: 9pt;
      color: #888;
      text-align: center;
      border-radius: 1mm;
    }
    /* Regola unica di altezza per tutte le figure `<img>` (Mermaid,
       Vega-Lite/DOT/function, immagini caricate): il tetto è il box della
       pagina (`--figure-h`, D12), non una costante. La larghezza degli SVG
       viene dalla banda di leggibilità come `style="width:Wmm"`
       sull'`<img>` (D10), già calcolata dentro il box: `max-height` è la
       cintura, `object-fit` evita la deformazione se scattasse. Le
       immagini caricate (dimensione intrinseca) non vengono mai
       ingrandite. */
    .slide-asset .figure-svg,
    .slide-asset .mermaid-svg,
    .slide-asset .uploaded-image {
      max-width: 100%;
      max-height: var(--figure-h);
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }
    /* Sorgente della figura quando il render è fallito (A23) e riferimenti
       senza asset: prima erano testo nudo. `white-space: pre`, non
       `pre-wrap`: una riga di sorgente è una riga resa e le righe più
       larghe del box sono tagliate a destra da `overflow: hidden`. È il
       percorso d'errore di una figura non resa (log
       `figure_render_fallback`): sei giri di stima delle righe a capo in
       `pre-wrap` sono stati battuti da Pango e da Chromium, il conteggio
       senza a capo è esatto nei due motori. `max-height` è solo la cintura
       per Chromium: WeasyPrint lo ignora sui blocchi frammentati dal fondo
       pagina (`weasyprint/layout/block.py`, «fill the blank space at the
       bottom of the page»), quindi il sorgente è troncato in Python alle
       righe che entrano nel box (`slide_geometry.truncate_fallback_source`,
       marcatore «…»). La dispensa resta in `pre-wrap`. */
    .slide-asset .figure-fallback,
    .slide-asset .mermaid-fallback {
      font-family: "Menlo", "Consolas", monospace;
      font-size: 7pt;
      line-height: 1.3;
      white-space: pre;
      text-align: left;
      background: #f5f5f7;
      border: 0.4pt solid #ddd;
      border-radius: 1mm;
      padding: 2mm 3mm;
      margin: 0;
      max-height: var(--figure-h);
      overflow: hidden;
    }
    .slide-asset .missing-asset,
    .slide-body .missing-asset {
      border: 0.5pt dashed #bbb;
      padding: 2mm 3mm;
      font-size: 8pt;
      color: #888;
      text-align: center;
      border-radius: 1mm;
    }

    /* Footer: linea sottile + organizzazione · corso, page counter dx.
       `right: 85mm` riserva la fascia bottom-right ~80mm per l'avatar
       (avatar largo ~65mm + 5mm di safety + 15mm di inset destro).
       Senza questa riserva, il page counter finirebbe sotto l'avatar. */
    .slide-footer {
      position: absolute;
      left: 18mm;
      right: 85mm;
      bottom: 10mm;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 6mm;
      z-index: 5;
    }
    .slide-footer .author-line {
      width: 42mm;
      height: 0.3mm;
      background: {{ tpl.text_color|safe }};
      opacity: 0.3;
    }
    .slide-footer .author-meta {
      margin-top: 2.5mm;
      font-size: 9pt;
      color: {{ tpl.text_color|safe }};
    }
    .slide-footer .author-meta .org {
      font-weight: 600;
    }
    .slide-footer .author-meta .sep {
      opacity: 0.6;
      margin: 0 1.5mm;
    }
    .slide-footer .author-meta .secondary {
      opacity: 0.7;
    }
    /* Credito prodotto: riga discreta sotto i metadati. Presente su ogni
       slide → compare anche nel video (frame renderizzati da queste slide)
       e nel video con avatar (overlay sul video lezione). Non rimovibile
       dal SlideTemplate DB-editabile (che controlla solo colori/font/loghi).
       Sta a sinistra: i 85mm di riserva destra restano per l'avatar. */
    .slide-footer .author-credit {
      margin-top: 1mm;
      font-size: 7.5pt;
      color: {{ tpl.text_color|safe }};
      opacity: 0.5;
    }
    .slide-footer .page-counter {
      font-family: "Menlo", "Consolas", monospace;
      font-size: 9pt;
      letter-spacing: 0.06em;
      opacity: 0.55;
      white-space: nowrap;
      color: {{ tpl.text_color|safe }};
    }

    math { font-size: 11pt; }
    /* Formule come SVG pre-renderizzato (MathJax); WeasyPrint non rende
       il MathML. Le equazioni-blocco sono già vincolate da `.slide-asset
       svg`; qui garantiamo che il math INLINE (celle tabella, esempi,
       titolo, prosa e bullet della slide) resti in linea e non venga
       forzato a blocco centrato. L'altezza di riga che una formula alta
       aggiunge alla prosa entra nel budget della figura
       (`slide_geometry.page_figure_budget`, WP4). */
    .math-block svg { display: block; margin: 0 auto; max-width: 100%; height: auto; }
    .slide-asset .math-inline svg, .math-inline svg {
      display: inline; margin: 0; max-height: none; max-width: 100%;
    }
    span.math-block { display: block; }
    /* Blocco teorema in slide: testo a sinistra, formule centrate,
       dimostrazione compatta (le slide hanno spazio verticale limitato). */
    .slide-asset figure.theorem { text-align: left; }
    .slide-asset figure.theorem .theorem-head {
      font-weight: 700; color: {{ tpl.primary_color|safe }}; margin-bottom: 1mm;
    }
    .slide-asset figure.theorem .math-block svg {
      /* Cap per singola formula dei passaggi: il blocco equazione non
         passa dal partial figura e resta fuori dal box di pagina (D12). */
      max-height: 40mm;
    }
    .slide-asset figure.theorem .proof {
      margin-top: 1.5mm; padding-left: 2.5mm;
      border-left: 1.5pt solid rgba(0, 0, 0, 0.15);
    }
    .slide-asset figure.theorem .proof-head {
      font-style: italic; font-weight: 600;
    }
    .slide-asset figure.theorem .proof-step { margin: 1mm 0; }
    .slide-asset figure.theorem .proof-qed { text-align: right; }
  </style>
</head>
{#
  Autoescape acceso (select_autoescape con «j2», come la dispensa): i campi
  d'autore escono escapati. Titolo, prosa e bullet arrivano come Markup da
  `render_markdown_inline` (testo escapato + formule SVG). `asset_html` è
  HTML costruito a monte (`|safe`): didascalie, attributi e URL escapati,
  ma il markdown di esempi, spiegazioni delle equazioni, enunciati e celle
  delle tabelle passa da `render_markdown`, che ammette HTML come nella
  dispensa. WeasyPrint non esegue script e legge solo data URL e l'host dei
  media; i frame video girano con JavaScript spento. I `tpl.*` nel CSS sono
  colori hex validati e numeri (`|safe`) o stringhe CSS (`|css_string`); i
  loghi in `src` restano all'escape HTML, la codifica giusta per un
  attributo.
#}
<body>
  {% for slide in slides %}
  <div class="slide">
    <div class="slide-bg"></div>

    <div class="slide-header">
      {% if tpl.logo_left_url %}
        <img class="logo-left" src="{{ tpl.logo_left_url }}" alt="" />
      {% else %}
        <span class="logo-spacer"></span>
      {% endif %}
      {% if tpl.logo_right_url %}
        <img class="logo-right" src="{{ tpl.logo_right_url }}" alt="" />
      {% else %}
        <span class="logo-spacer"></span>
      {% endif %}
    </div>

    <div class="slide-body">
      <div class="slide-tag">{{ lesson_label }}</div>
      <h1 class="slide-title">{{ slide.title }}</h1>

      {% if slide.body %}
      <p class="slide-body-text">{{ slide.body }}</p>
      {% endif %}

      {% if slide.bullets %}
      <ul class="slide-bullets">
        {% for b in slide.bullets %}
        <li>{{ b }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if slide.assets_html %}
      <div class="slide-assets">
        {% for asset_html in slide.assets_html %}
        <div class="slide-asset">{{ asset_html|safe }}</div>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="slide-footer">
      <div>
        <div class="author-line"></div>
        <div class="author-meta">
          <span class="secondary">{{ course.title }}</span>
          {% if course.cfu %}
          <span class="sep">·</span>
          <span class="secondary">{{ course.cfu }} {{ cfu_label }}</span>
          {% endif %}
          <span class="sep">·</span>
          <span class="secondary">{{ lesson.title }}</span>
          {% if course.teacher %}
          <span class="sep">·</span>
          <span class="secondary">{{ course.teacher }}</span>
          {% endif %}
        </div>
        <div class="author-credit">Generated by Avatar4University</div>
      </div>
      <div class="page-counter">
        {{ "%02d"|format(slide.slide_number) }} / {{ "%02d"|format(total_slides) }}
      </div>
    </div>
  </div>
  {% endfor %}
</body>
</html>
