{#- Partial unico delle figure (D4): PDF dispensa, PDF slide e frame video.
    Reso da `figure_markup.render_figure_html` con autoescape attivo:
    `body_html` è Markup prodotto dal renderer (SVG inline o <img>),
    tutto il resto (didascalia, alt, id, sorgente di fallback) è escapato.
    Nessuna riga vuota nell'output: il blocco entra nel markdown della
    dispensa come HTML block (markdown-it lo chiude alla prima riga vuota). -#}
<figure class="visual figure figure--{{ variant }} figure--{{ fmt_class }}" data-asset-id="{{ asset_id }}" role="figure" aria-label="{{ aria_label }}">
<div class="figure-body">{% if body_html is not none %}{{ body_html }}{% else %}<pre class="figure-fallback">{{ fallback_source }}</pre>{% endif %}</div>
<figcaption class="figure-caption"><span class="figure-label">{{ label }}</span>{% if caption %} {{ caption }}{% endif %}{% if extra_caption %} {{ extra_caption }}{% endif %}</figcaption>
</figure>
