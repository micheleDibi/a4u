# Unico file di env condiviso tra docker-compose e backend FastAPI.

# === Postgres (servizio docker compose) ===
POSTGRES_USER=a4u
POSTGRES_PASSWORD=a4u_dev_password
POSTGRES_DB=a4u
POSTGRES_PORT=5432

# === Porte stack produzione (docker-compose.prod.yml) ===
# Frontend (nginx pubblico). Default: 80.
FRONTEND_PORT=80
# Backend FastAPI. Default: esposto solo su localhost del server
# (`127.0.0.1:8000`) — il traffico esterno passa via reverse proxy
# del frontend. Esempi alternativi:
#   BACKEND_PORT=8000           → esposto su tutte le interfacce
#   BACKEND_PORT=192.168.1.10:8000 → solo interfaccia LAN specifica
BACKEND_PORT=127.0.0.1:8000

# === Backend (FastAPI / pydantic-settings) ===
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json (json in produzione)

DATABASE_URL=postgresql+asyncpg://a4u:a4u_dev_password@localhost:5432/a4u
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Sostituire con un valore casuale di almeno 32 byte (es. `openssl rand -hex 48`)
JWT_SECRET=change-me-please-use-a-real-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false           # true in produzione (HTTPS)

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
AVATAR_AUDIO_MAX_MB=10
# In dev locale, MiniMax deve poter raggiungere /uploads/... su questa URL.
# Per testare la generazione clip, esporre via ngrok e mettere qui l'URL pubblico.
PUBLIC_BASE_URL=http://localhost:8000

# === Storage backend (dove vivono i file: PDF, video, upload) ===
# local    → filesystem locale (default, dev): comportamento storico.
# ovh_ftp  → server OVH via FTP/FTPS (porta 21).
# ovh_sftp → server OVH via SFTP (porta 22, su SSH). Più robusto.
# In ovh_* i file sono serviti pubblicamente via HTTP da OVH_PUBLIC_BASE_URL.
# Vedi app/services/remote_storage.py.
STORAGE_BACKEND=local
# Durante il cutover (Fase 3): se un file non è ancora su OVH, leggi/servi
# dal filesystem locale ancora montato. Mettere false a regime (Fase 4).
STORAGE_LOCAL_FALLBACK=true
# --- Credenziali OVH (necessarie con STORAGE_BACKEND=ovh_ftp|ovh_sftp) ---
OVH_FTP_HOST=ftp.clusterXXX.hosting.ovh.net    # dal pannello OVH (campo "Server FTP e SFTP")
OVH_FTP_PORT=21
OVH_SFTP_PORT=22
OVH_FTP_USER=progetn
OVH_FTP_PASSWORD=
# Cartella radice in cui finiscono le key uploads/... e generated_pdfs/...,
# che mappa al docroot pubblico. ATTENZIONE alla differenza:
#   - ovh_ftp  → FTP è chrooted nella home: usa il path relativo alla home,
#                es. `/www/media`.
#   - ovh_sftp → SFTP NON è chrooted: usa il path ASSOLUTO reale, es.
#                `/home/<utente>/www/media` (la home è nel pannello OVH).
OVH_FTP_BASE_PATH=/home/progetn/www/media
# FTPS esplicito (TLS) — solo per ovh_ftp. false SOLO per debug. Ignorato da SFTP.
OVH_FTP_USE_TLS=true
OVH_FTP_TIMEOUT_SECONDS=30
# URL pubblica da cui i file OVH sono serviti via HTTP. Deve corrispondere
# alla cartella di OVH_FTP_BASE_PATH (stessa cartella fisica). Es. /media:
OVH_PUBLIC_BASE_URL=https://progettiersaf.com/media

# Frontend (build arg Vite): base URL pubblica per i media inline (immagini
# embedded nelle lezioni/slide). Con STORAGE_BACKEND=ovh_ftp deve essere
# OVH_PUBLIC_BASE_URL + "/uploads". In dev/local lasciare /uploads.
VITE_UPLOADS_BASE_URL=https://progettiersaf.com/media/uploads

# === MiniMax (generazione clip video avatar) ===
# Lascia vuoto per disabilitare la generazione (i clip resteranno in stato pending).
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
MINIMAX_CLIP_DURATION=6
MINIMAX_CLIP_RESOLUTION=1080P
MINIMAX_POLL_INTERVAL_SECONDS=10

# === OpenAI ===
# Lascia OPENAI_API_KEY vuota per disabilitare TUTTE le funzioni AI
# (traduzione i18n, summarization documenti, generazione architettura
# corso, lesson structure, lesson content). Tutto il resto resta
# pendente in stato `pending` finché non valorizzi la chiave.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelli per le diverse fasi (ognuna usa un setting separato):
OPENAI_MODEL=gpt-4o-mini                 # traduzione i18n (Completa con AI)
OPENAI_TRANSLATE_BATCH_SIZE=40
OPENAI_SUMMARIZE_MODEL=gpt-4o-mini       # summary documenti corso
OPENAI_SUMMARIZE_MAX_TOKENS=8000
# Copertura totale analisi documenti: sopra la soglia single-shot il
# riassunto passa da map (per-chunk) -> merge -> reduce, coprendo il
# documento per intero fino all'hard cap. Kill-switch per tornare al
# comportamento storico (troncamento a COURSE_DOCUMENT_MAX_CHARS).
OPENAI_SUMMARIZE_MAP_MAX_TOKENS=4000
OPENAI_SUMMARIZE_REDUCE_MAX_TOKENS=12000
COURSE_DOCUMENT_FULL_COVERAGE_ENABLED=true
COURSE_DOCUMENT_SINGLESHOT_MAX_CHARS=100000
COURSE_DOCUMENT_CHUNK_CHARS=24000
COURSE_DOCUMENT_CHUNK_OVERLAP_CHARS=1500
COURSE_DOCUMENT_MAX_CHARS_HARD=2000000
COURSE_DOCUMENT_CHUNK_CONCURRENCY=3
COURSE_DOCUMENT_LLM_RETRY_MAX=4
COURSE_DOCUMENT_REDUCE_INPUT_MAX_CHARS=80000
COURSE_DOCUMENT_REDUCE_GROUP_SIZE=20
COURSE_DOCUMENT_SUMMARY_ATTEMPTS_MAX=10
# --- Grounding delle dispense (Fase 3) sui documenti caricati ---
# Budget (caratteri) del blocco documenti selezionato per lezione, tetto per
# singolo documento rilevante e kill-switch: con `false` torna il comportamento
# storico (nessuna selezione per lezione, niente esempi/formule dai riassunti,
# vecchio blocco RIFERIMENTI). Utile per la campagna before/after del registro.
COURSE_LESSON_CONTENT_DOCUMENTS_CONTEXT_MAX_CHARS=40000
COURSE_LESSON_CONTENT_DOCUMENTS_PER_DOC_MAX_CHARS=12000
COURSE_LESSON_CONTENT_DOCUMENTS_SELECTION_ENABLED=true
OPENAI_MODULES_LESSONS_MODEL=gpt-5.5     # generazione architettura
OPENAI_ARCHITECTURE_MAX_TOKENS=8000      # alza a 16000 se "finish_reason=length"
OPENAI_ARCHITECTURE_REASONING_EFFORT=medium     # [minimal, low, medium, high]
OPENAI_LESSON_STRUCTURE_MODEL=gpt-5.5    # generazione struttura lezione
OPENAI_LESSON_STRUCTURE_MAX_TOKENS=16000
OPENAI_LESSON_STRUCTURE_REASONING_EFFORT=medium # [minimal, low, medium, high]
OPENAI_LESSON_CONTENT_MODEL=gpt-5.5      # generazione contenuto lezione
OPENAI_LESSON_CONTENT_MAX_TOKENS=32000
# Reasoning effort di Fase 3/4/5: i default del codice sono high/medium/medium.
# Il valore viene inviato così com'è (anche "none"): con "none" la revisione
# interna in due fasi e la verifica finale del REGISTRO nel prompt sono
# nominali. Per una campagna di confronto before/after usare il valore
# attuale di produzione, così il delta è attribuibile al prompt.
OPENAI_LESSON_CONTENT_REASONING_EFFORT=none     # [minimal, low, medium, high]
OPENAI_LESSON_SLIDES_MODEL=gpt-5.5       # generazione slide lezione (Fase 4)
OPENAI_LESSON_SLIDES_MAX_TOKENS=16000
OPENAI_LESSON_SLIDES_REASONING_EFFORT=none    # [minimal, low, medium, high]
OPENAI_LESSON_SPEECH_MODEL=gpt-5.5       # generazione discorso temporizzato (Fase 5)
OPENAI_LESSON_SPEECH_MAX_TOKENS=16000
OPENAI_LESSON_SPEECH_REASONING_EFFORT=none    # [minimal, low, medium, high]

# --- Asset delle lezioni: digitalizzazione, auto-fix, localizzazione ---
# Image → Mermaid ("Digitalizza" nell'editor): il modello deve accettare
# input multimodale; gpt-4o non usa reasoning (effort vuoto = non inviato).
OPENAI_IMAGE_TO_MERMAID_MODEL=gpt-4o
OPENAI_IMAGE_TO_MERMAID_REASONING_EFFORT=
OPENAI_IMAGE_TO_MERMAID_MAX_TOKENS=4000
# Auto-fix degli asset fragili (LaTeX, Mermaid, Vega-Lite, DOT, function)
# generati in Fase 3/4: un asset che non supera la validazione viene
# riparato con una chiamata AI mirata e rivalidato, fino a
# ASSET_FIX_MAX_ATTEMPTS tentativi; poi la lezione rientra nell'auto-retry.
OPENAI_ASSET_FIX_MODEL=gpt-4o-mini
OPENAI_ASSET_FIX_REASONING_EFFORT=
OPENAI_ASSET_FIX_MAX_TOKENS=4000
ASSET_FIX_MAX_ATTEMPTS=3
# Localizzazione degli asset (rete di sicurezza i18n): ritraduce i campi
# testuali lasciati in una lingua diversa da quella del corso. Si attiva
# solo per lingue con script non latino; ASSET_LOCALIZE_ENABLED=false la
# disattiva del tutto.
OPENAI_ASSET_LOCALIZE_MODEL=gpt-4o-mini
OPENAI_ASSET_LOCALIZE_MAX_TOKENS=8000
ASSET_LOCALIZE_ENABLED=true
# Revisore AI figura ↔ testo (Fase 3): dopo il fix, ogni figura valida è
# confrontata con il testo della sezione che la cita e con la sua misura
# (nodi, archi, incroci, difetti). Verdetto predefinito `coerente`; una
# riscrittura è accettata solo se valida e non peggiora la misura. Il costo
# entra in content_tokens.assets. FIGURE_REVIEW_ENABLED=false spegne la
# fase senza alcuna chiamata; FIGURE_REVIEW_MAX_ATTEMPTS limita le chiamate
# per figura (0 = nessuna) e FIGURE_REVIEW_MAX_PARALLEL quelle in volo per
# processo.
OPENAI_FIGURE_REVIEW_MODEL=gpt-4o-mini
OPENAI_FIGURE_REVIEW_REASONING_EFFORT=
OPENAI_FIGURE_REVIEW_MAX_TOKENS=4000
FIGURE_REVIEW_MAX_ATTEMPTS=2
FIGURE_REVIEW_MAX_PARALLEL=4
FIGURE_REVIEW_ENABLED=true

# --- Figure accademiche (Fase 3/4) ---
# Quattro famiglie di figure renderizzate dal backend: Mermaid (sempre
# attivo), Vega-Lite (vl-convert, senza browser), Graphviz DOT (binario
# `dot`: apt-get install graphviz), `function` (sympy + matplotlib). Un
# kill-switch a `false` toglie il formato dallo schema offerto al modello
# e dal validatore; i contenuti già in DB con quel formato degradano al
# fallback testuale nel PDF.
FIGURE_VEGALITE_ENABLED=true
FIGURE_DOT_ENABLED=true
FIGURE_FUNCTION_ENABLED=true
# Pin unico di Mermaid (validatore Playwright + pre-render PDF/video).
MERMAID_CDN_VERSION=11.17.2
# Pin di MathJax (tex-svg) per il pre-render delle formule (PDF/video).
MATHJAX_CDN_VERSION=3.2.2
# Tetti: render di un batch di figure per lezione; calcolo simbolico di
# `function` (processo figlio ucciso allo scadere → valori approssimati).
FIGURE_RENDER_TIMEOUT_SECONDS=20
FIGURE_FUNCTION_TIMEOUT_SECONDS=10
# Render CPU-bound concorrenti (worker + anteprime): 2 sulla VM a 2 core.
FIGURE_RENDER_MAX_WORKERS=2
# Cache LRU degli SVG in memoria e dimensione massima di un SVG accettato.
FIGURE_SVG_CACHE_SIZE=256
FIGURE_SVG_MAX_BYTES=1500000
# Limite del sorgente DOT; percorso di `dot` (vuoto = ricerca nel PATH).
FIGURE_DOT_MAX_CHARS=12000
GRAPHVIZ_DOT_PATH=

# --- Figure da letteratura (figure di fonte) ---
# Figure estratte dai documenti del corso e citate in lezione con la riga
# «Fonte» calcolata a render (docs/courses/18-literature-figures.md).
# FIGURE_SOURCE_ENABLED=false toglie il catalogo dal prompt di Fase 3.
FIGURE_SOURCE_ENABLED=true
# cite_all = qualunque licenza con attribuzione completa; open_only = solo
# CC0, CC BY, CC BY-SA, pubblico dominio e documenti propri del docente.
# Sovrascrivibile per organizzazione dalle impostazioni dei corsi.
FIGURE_SOURCE_LICENSE_POLICY=cite_all
# Catalogo per lezione (voci, caratteri) e budget delle figure di fonte
# (lezione ordinaria / introduttiva), separato da quello delle generate.
FIGURE_SOURCE_CATALOG_MAX_ITEMS=8
FIGURE_SOURCE_CATALOG_MAX_CHARS=4000
FIGURE_SOURCE_MAX_PER_LESSON=4
FIGURE_SOURCE_MAX_PER_INTRO_LESSON=1
# Sotto questa soglia di figure pertinenti una lezione è «in buco».
FIGURE_SOURCE_MIN_PER_LESSON=1
# Una figura di fonte in al più N lezioni del corso (1 = una sola lezione).
FIGURE_SOURCE_MAX_LESSONS_PER_FIGURE=2
# Risoluzione effettiva delle figure di fonte (classi e regola di stampa).
FIGURE_RESOLUTION_RULES_ENABLED=true
# Ritaglio v2 delle figure estratte (griglia nativa, PNG per il tratto).
FIGURE_EXTRACTION_NATIVE_CROP_ENABLED=true
# Attesa massima della Fase 3 per le estrazioni ancora in corso.
FIGURE_WAIT_MAX_MINUTES=15
# Estrazione delle figure dai documenti (Docling su CPU, processo figlio).
# In produzione accenderla solo dopo la misura M0 sulla VM (vedi
# docs/07-deployment.md): senza AVX torch può non partire.
FIGURE_EXTRACTION_ENABLED=false
# docling (default) | heuristic (senza torch, qualità minore).
FIGURE_EXTRACTION_ENGINE=docling
FIGURE_EXTRACTION_THREADS=1
FIGURE_EXTRACTION_BLOCK_PAGES=10
FIGURE_EXTRACTION_PAGES_PER_CHILD=40
# Tetto di pagine per documento e tempo massimo di un giro: 0 = nessun tetto
# (copertura totale; resta il tempo massimo di ogni blocco).
FIGURE_EXTRACTION_MAX_PAGES=0
FIGURE_EXTRACTION_TOTAL_TIMEOUT_SECONDS=0
FIGURE_EXTRACTION_PROBE_TIMEOUT_SECONDS=180
# Watchdog di memoria del figlio e memoria minima libera prima di ogni blocco.
FIGURE_EXTRACTION_MAX_RSS_MB=2048
FIGURE_EXTRACTION_MIN_AVAILABLE_MB=1800
FIGURE_EXTRACTION_MAX_DEFER_MINUTES=180
FIGURE_EXTRACTION_AUTO_RETRY_MAX=3
FIGURE_EXTRACTION_ATTEMPTS_MAX=6
FIGURE_EXTRACTION_POLL_INTERVAL_SECONDS=5
# Modelli Docling preinstallati nell'immagine (niente download a runtime).
FIGURE_DOCLING_ARTIFACTS_PATH=/opt/docling-models
FIGURE_MIN_QUALITY_SCORE=3
# Figure descritte dalla Vision per documento: 0 = tutte.
FIGURE_DESCRIBE_MAX_PER_DOCUMENT=0
# Descrizione Vision delle figure (il modello deve essere a listino in
# openai_pricing, altrimenti il costo non compare nella dashboard admin).
OPENAI_FIGURE_DESCRIBE_MODEL=gpt-4.1-mini
OPENAI_FIGURE_DESCRIBE_REASONING_EFFORT=
OPENAI_FIGURE_DESCRIBE_MAX_TOKENS=800
OPENAI_FIGURE_DESCRIBE_DETAIL=high
OPENAI_FIGURE_DESCRIBE_TIMEOUT_SECONDS=60
OPENAI_FIGURE_DESCRIBE_CONCURRENCY=3
# Revisore delle figure di fonte (coerenza e ridondanza): segnala soltanto.
FIGURE_REDUNDANCY_ENABLED=true
FIGURE_REDUNDANCY_MAX_ATTEMPTS=2
FIGURE_REDUNDANCY_TIMEOUT_SECONDS=120
OPENAI_FIGURE_REDUNDANCY_MODEL=gpt-4o-mini
OPENAI_FIGURE_REDUNDANCY_REASONING_EFFORT=
OPENAI_FIGURE_REDUNDANCY_MAX_TOKENS=1500
FIGURE_REDUNDANCY_SUBJECT_CHECK_ENABLED=true
# Fase 4: slide dedicata inserita per ogni figura di Fase 3 rimasta senza.
FIGURE_SLIDES_COVERAGE_REPAIR_ENABLED=true
# Letteratura aperta (WP5): lezioni senza figure di fonte pertinenti dai
# documenti ricevono figure da Wikimedia Commons e, con OPENALEX_API_KEY,
# dai PDF open access di OpenAlex (solo i ritagli, mai documenti). Spenta
# finché non la si accende: rete esterna e costo Vision (PROMPT 20).
FIGURE_LITERATURE_ENABLED=false
FIGURE_LITERATURE_MAX_CANDIDATES_PER_LESSON=15
FIGURE_LITERATURE_MAX_CANDIDATES_PER_NEED=3
FIGURE_LITERATURE_MAX_COST_USD_PER_CHECK=0.08
FIGURE_LITERATURE_MAX_PAID_PDF_PER_LESSON=3
FIGURE_LITERATURE_MAX_PER_COURSE=40
FIGURE_LITERATURE_TIMEOUT_SECONDS=300
FIGURE_LITERATURE_MAX_IMAGE_MB=20
FIGURE_LITERATURE_MAX_PDF_MB=30
FIGURE_LITERATURE_MAX_IMAGE_PIXELS=16000000
FIGURE_LITERATURE_MAX_PDF_PAGES=40
FIGURE_LITERATURE_IMAGE_WIDTH=1920
FIGURE_LITERATURE_AUTO_RETRY_MAX=2
FIGURE_LITERATURE_POLL_INTERVAL_SECONDS=5
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
# Obbligatoria per OpenAlex dal 13/02/2026 (anche per la ricerca paper).
OPENALEX_API_KEY=
OPENAI_FIGURE_RELEVANCE_MODEL=gpt-4.1-mini
OPENAI_FIGURE_RELEVANCE_REASONING_EFFORT=
OPENAI_FIGURE_RELEVANCE_MAX_TOKENS=800
OPENAI_FIGURE_RELEVANCE_TIMEOUT_SECONDS=60
# Piano delle figure di fonte: fabbisogni per lezione (PROMPT 22).
FIGURE_PLAN_ENABLED=true
OPENAI_FIGURE_NEEDS_MODEL=gpt-5.5
OPENAI_FIGURE_NEEDS_REASONING_EFFORT=none
OPENAI_FIGURE_NEEDS_MAX_TOKENS=4500
OPENAI_FIGURE_NEEDS_TIMEOUT_SECONDS=90
FIGURE_NEEDS_CONCURRENCY=4
FIGURE_NEEDS_AUTO_RETRY_MAX=3
FIGURE_NEEDS_POLL_INTERVAL_SECONDS=5
FIGURE_NEEDS_MAX_PER_LESSON=10
FIGURE_NEEDS_MAX_PER_INTRO_LESSON=3
FIGURE_PLAN_MAX_PER_LESSON=8
FIGURE_SOURCE_MINUTES_PER_FIGURE=4
FIGURE_PLAN_LEGACY_MATCH_ENABLED=false
FIGURE_PLAN_IN_PROMPT_ENABLED=true
# Formato tikz (WP6): XeLaTeX nella sandbox del container. Spento: TeX Live
# entra nell'immagine solo con `docker compose build --build-arg
# INSTALL_TEX=true backend` (circa +550 MB). FIGURE_TIKZ_PROPOSE_ENABLED
# lascia che il modello di Fase 3 lo proponga da sé (altrimenti solo editor).
FIGURE_TIKZ_ENABLED=false
FIGURE_TIKZ_PROPOSE_ENABLED=false
FIGURE_TIKZ_MAX_CHARS=8000
FIGURE_TIKZ_TIMEOUT_SECONDS=10
FIGURE_TIKZ_QUEUE_TIMEOUT_SECONDS=30
FIGURE_TIKZ_FIX_MAX_ATTEMPTS=1
FIGURE_TIKZ_RENDER_REVIEW_ENABLED=true
OPENAI_TIKZ_REVIEW_MODEL=gpt-4.1-mini
OPENAI_TIKZ_REVIEW_MAX_TOKENS=1500
FIGURE_TIKZ_PREVIEW_PER_MINUTE=10
TEX_BIN_DIR=

# Note:
# - "gpt-5.5" è il default per le fasi reasoning-heavy del pipeline.
#   Se non hai accesso a quel modello, sostituisci con "gpt-4o" (più
#   economico ma meno preciso su prompt complessi) o "o1-mini".
# - I `*_max_tokens` sono budget di OUTPUT; i modelli reasoning consumano
#   parecchi token nel pensiero interno PRIMA di emettere JSON, quindi
#   non sono molto oltre la lunghezza visibile attesa.
# - `*_reasoning_effort` controlla quanto "pensa" il modello prima di
#   rispondere. Effetto su qualità e tempi:
#     minimal → output quasi immediato, niente reasoning (solo gpt-5.x).
#     low     → ~1-3s reasoning, qualità base.
#     medium  → ~5-15s reasoning, default consigliato.
#     high    → ~20-60s reasoning, massima qualità (default su contenuto
#               lezione perché il task è il più complesso del pipeline).
#   I modelli o1/o1-mini accettano solo [low, medium, high] (non minimal).
#   I modelli non-reasoning (gpt-4o, gpt-4o-mini) ignorano il parametro.

# === Parallelismo worker pipeline corso ===
# Quante lezioni vengono generate in parallelo per ogni fase. I default
# sono prudenti per non triggerare rate-limit OpenAI con tier free/1.
# Per corsi grandi (12+ CFU = 24-30 lezioni) e API key OpenAI tier 2+
# (alti TPM/RPM), alza questi valori per drasticamente ridurre i tempi.
#
# Tempo stimato per corso da 30 lezioni:
#   concurrency=3  → ~90-120 min  (default, sicuro)
#   concurrency=8  → ~30-45 min   (consigliato tier 2+)
#   concurrency=15 → ~15-25 min   (tier 3+, ma rischio 429 più alto)
COURSE_LESSON_STRUCTURE_MAX_CONCURRENCY=5
COURSE_LESSON_CONTENT_MAX_CONCURRENCY=3
COURSE_LESSON_SLIDES_MAX_CONCURRENCY=3
COURSE_LESSON_SPEECH_MAX_CONCURRENCY=3
COURSE_LESSON_PDF_MAX_CONCURRENCY=2
# Worker generazione video MP4 (Fase 6 §9). Il TTS gira su RunPod GPU;
# localmente restano slide-render (Playwright) ed encoding (ffmpeg).
# Default safe = 1 sulla VM 2-core.
COURSE_LESSON_VIDEO_MAX_CONCURRENCY=1

# Polling interval del worker (secondi).
COURSE_LESSON_STRUCTURE_POLL_INTERVAL_SECONDS=4
COURSE_LESSON_CONTENT_POLL_INTERVAL_SECONDS=4
COURSE_LESSON_SLIDES_POLL_INTERVAL_SECONDS=4
COURSE_LESSON_SPEECH_POLL_INTERVAL_SECONDS=4
COURSE_LESSON_PDF_POLL_INTERVAL_SECONDS=4
COURSE_LESSON_VIDEO_POLL_INTERVAL_SECONDS=4

# Auto-retry trasparente prima del fail terminale.
COURSE_LESSON_STRUCTURE_AUTO_RETRY_MAX=5
COURSE_LESSON_CONTENT_AUTO_RETRY_MAX=5
COURSE_LESSON_SLIDES_AUTO_RETRY_MAX=5
COURSE_LESSON_SPEECH_AUTO_RETRY_MAX=5
COURSE_LESSON_PDF_AUTO_RETRY_MAX=5
# Video: 3 retry sono sufficienti — i fail comuni (voice sample
# mancante, ffmpeg KO, job RunPod fallito) non sono recuperabili da
# soli, e ogni tentativo richiede minuti.
COURSE_LESSON_VIDEO_AUTO_RETRY_MAX=3

# === Generazione video MP4 (Fase 6 §9) ===
# Pre-condizione runtime: lezione con speech_status='approved' AND
# slides_status='approved' AND Avatar.audio_path popolato per l'utente
# assegnatario al corso AND servizio TTS RunPod configurato.
#
# TTS XTTS-v2 su RunPod Serverless GPU (vedi cartella `XTTS/` del repo).
# Lascia RUNPOD_API_KEY / RUNPOD_TTS_ENDPOINT_ID vuoti per disabilitare
# la generazione video.
RUNPOD_API_KEY=
RUNPOD_TTS_ENDPOINT_ID=
RUNPOD_BASE_URL=https://api.runpod.ai
RUNPOD_TTS_TIMEOUT_SECONDS=1800     # timeout job (assorbe il cold start)
RUNPOD_TTS_POLL_INTERVAL_SECONDS=3

# "Video con Avatar" (Fase 6b §9b) — lip-sync MuseTalk su RunPod GPU,
# sovrapposto al video MP4 della lezione. Stesso account RunPod del TTS
# (RUNPOD_API_KEY riusato), endpoint serverless dedicato a MuseTalk.
# Cloudflare R2 (S3-compatible) è lo storage di transito del job.
# Lascia questi vuoti per disabilitare il "Video con Avatar".
RUNPOD_MUSETALK_ENDPOINT_ID=
R2_ENDPOINT=                        # https://<account>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Overlay dell'avatar sul video: lato del quadrato come frazione della
# larghezza del video, e margine dai bordi in pixel.
AVATAR_VIDEO_OVERLAY_SCALE=0.24
AVATAR_VIDEO_OVERLAY_MARGIN=24
# Risoluzione (lato del quadrato) a cui a4u ridimensiona le clip avatar
# prima di passarle a MuseTalk. Le clip MiniMax sono 1080×1080: a quella
# risoluzione il lip-sync su RunPod sfora il tetto di 60 min. 640 = ok.
AVATAR_VIDEO_CLIP_RESOLUTION=640

# Encoding ffmpeg (richiede binario `ffmpeg` in PATH).
# Preset 1080p30 H.264 + AAC 192 kbps, CRF 23 (qualità tipo YouTube).
# Peso ~25 MB per 10 min di video.
VIDEO_RESOLUTION=1920x1080
VIDEO_FRAMERATE=30
VIDEO_AUDIO_BITRATE=192k
VIDEO_AUDIO_SAMPLE_RATE=48000
VIDEO_VIDEO_CODEC=libx264
VIDEO_CRF=23                  # 18=alta qualità, 28=compresso
VIDEO_PIXEL_FORMAT=yuv420p    # compat HTML5/QuickTime
LESSON_VIDEO_MAX_MB=500
FFMPEG_BINARY=ffmpeg          # path assoluto se non in PATH

# Bootstrap dell'admin di piattaforma alla prima migrazione/avvio.
# Se vuoti, nessun admin viene creato automaticamente.
BOOTSTRAP_ADMIN_EMAIL=admin@a4u.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FULL_NAME=Platform Admin

RATE_LIMIT_LOGIN_PER_MIN=5
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# Opzionale: error monitoring
SENTRY_DSN=
